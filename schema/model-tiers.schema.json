{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deximple/model-tf/schema/model-tiers.schema.json",
  "title": "model-tiers",
  "description": "Model evaluation tiers. The unit is model x effort. Entries stand on facts: a key that is absent from model-facts.json is ignored. Community evidence alone cannot set a tier; at least one benchmark or vendor evidence item is required.",
  "type": "object",
  "required": ["version", "date", "factsDate", "axis", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Bundle date (YYYY-MM-DD)."
    },
    "factsDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date of the model-facts.json bundle these tiers were evaluated against."
    },
    "axis": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Task axes ranks are given for (e.g. simpleCoding, reasoning)."
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["key", "effort", "tier", "rank", "evidence"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$",
          "description": "vendorId/model, matching a model in model-facts.json."
        },
        "effort": {
          "type": "string",
          "minLength": 1,
          "description": "Reasoning effort. 'default' is used for models with a single configuration."
        },
        "tier": {
          "enum": ["frontier", "mid", "low"]
        },
        "rank": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Relative rank per task axis, 1 is best. Intermediate axis values are interpolated by consumers."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "source", "checkedAt"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["benchmark", "vendor", "community"],
          "description": "benchmark = independent evals, vendor = maker's own claims, community = Reddit/X etc. Community alone cannot set a tier."
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "checkedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
